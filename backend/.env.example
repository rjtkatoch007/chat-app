DB_NAME=chatapp
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret

# AWS S3 media storage. Never put these values in frontend code.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=expense-s3-bucket-zena
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
MEDIA_MAX_BYTES=26214400

# Nightly archive schedule (server timezone; default 02:00)
ARCHIVE_CRON_HOUR=2
ARCHIVE_CRON_MINUTE=0
ARCHIVE_BATCH_SIZE=500
